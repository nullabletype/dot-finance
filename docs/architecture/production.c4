model {
  production = system 'Production application foundation' {
    description 'One self-contained, trimmed executable per target; native libraries extract privately at runtime. The reconciliation domain and encrypted SQLite3MC persistence are implemented. Application workflow UI and importing remain planned.'
    desktop = component 'Desktop host' {
      technology 'Avalonia / .NET 10'
      description 'Implemented native window and composition boundary. Contains no user-facing financial workflow; native validation commands exercise the composed vault adapter with synthetic state.'
    }
    application = component 'Application boundary' {
      technology 'C# project'
      description 'Owns the vault port and reconciliation-completion use case, including the configured automatic encrypted backup.'
    }
    domain = component 'Domain boundary' {
      technology 'C# project'
      description 'Implemented pure financial domain; no Avalonia or SQLite dependency. Implements allocation, signed funding, correction adjustments, protected minima and the reconciliation lifecycle without I/O.'
      calculation = component 'Allocation and funding' {
        description 'Configured responsibilities, linked refunds, signed GBP contributions, personal priority, protected minima and reporting totals.'
      }
      book = component 'Reconciliation book' {
        description 'One draft; reviewable imports and corrections; locked reservations; manual acknowledgements; immutable completed snapshots and bounded reopening.'
      }
      book -> calculation 'Recalculates editable drafts and projects remaining agreed steps'
    }
    importer = component 'PLANNED import adapter' {
      description 'Issue #30: verified offline CSV parsing. Not implemented.'
    }
    storage = component 'Encrypted vault adapter' {
      technology 'SQLite3MC / Microsoft.Data.Sqlite'
      description 'Implemented versioned schema, complete reconciliation-state persistence, migrations and interruption-safe encrypted backup/restore. Pins sqleet ChaCha20, authenticated pages and a 600,000-iteration PBKDF2-SHA256 work factor.'
      schema = component 'Schema and state codec' {
        description 'Versioned strict metadata and keyed entity tables with incremental transactional upserts and trim-safe row codecs for the storage-neutral domain state contract.'
      }
      recovery = component 'Backup and recovery' {
        description 'Stages, validates and atomically replaces encrypted backups or restored working vaults without presenting partial files as complete.'
      }
      recovery -> schema 'Validates schema, integrity and complete domain state before replacement'
    }
    settings = component 'PLANNED preferences adapter' {
      description 'Issue #31: non-sensitive local settings. Not implemented.'
    }
    desktop -> application 'Project reference; composes application use cases'
    desktop -> storage 'Composition and native persistence validation commands'
    application -> domain 'Project reference; coordinates financial transitions'
    storage -> application 'Implements the consumer-owned vault port'
  }
  vaultFiles = system 'Local encrypted vault files' {
    description 'Owner-selected working database and portable backup files. They contain no plaintext header and use the same user-provided password. Partial candidates have recognisable suffixes and are never accepted as backups.'
  }
  extraction = system 'Private native-library cache' {
    description '.NET runtime-managed extraction by application and bundle identity; reused on launch, separate for updated bundles. No financial data or passwords.'
  }
  user -> production.desktop 'Opens the minimal native window'
  production.desktop -> extraction 'Runtime extracts bundled native libraries before startup'
  production.storage -> vaultFiles 'Transactional save, validated backup and restore'
  build -> production 'Builds, checks boundaries and publishes one executable locally; no release publishing'
}

views {
  view reconciliationDomain {
    title 'PRODUCTION — pure reconciliation domain'
    include production.domain, production.domain.*
  }
  view productionFoundation {
    title 'PRODUCTION FOUNDATION — implemented boundaries and planned adapters'
    include user, production, production.*, extraction
  }
  view encryptedVault {
    title 'PRODUCTION — encrypted vault and recovery'
    include production.desktop, production.storage, production.storage.*, production.domain, vaultFiles, extraction
  }
}
