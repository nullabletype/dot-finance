specification {
  element actor
  element system
  element component
}

model {
  user = actor 'Desktop user'
  prototype = system 'Experimental desktop shell' {
    description 'Disposable issues #1 through #3 experiment. Entirely local; no banking connections or payment operations.'
    ui = component 'Guided reconciliation window' {
      technology 'Avalonia / .NET 10'
      description 'Guides fictional import, live allocation review, balance entry, transfer review, manual acknowledgements and history inspection in System, Light and Dark themes.'
    }
    importer = component 'Bounded synthetic CSV importer' {
      technology 'CsvHelper'
      description 'Reads the committed fictional fixture under explicitly recorded, unverified Emma format assumptions.'
    }
    vault = component 'Experimental encrypted vault' {
      technology 'Microsoft.Data.Sqlite and SQLite3MC'
      description 'Persists one JSON state document in an encrypted SQLite database and makes validated atomic backup and restore replacements.'
    }
    workflow = component 'Guided workflow session' {
      technology 'C#'
      description 'Owns the editable draft, accepted corrections and overrides, discrepancy acknowledgement, locking, pending imports, settlement and completed history.'
    }
    engine = component 'Reconciliation engine' {
      technology 'Pure C# calculations'
      description 'Allocates transactions and calculates contributions, protected-balance shortfalls, frozen transfers and remaining-step projections.'
    }
    settings = component 'Theme settings' {
      technology 'Local JSON'
      description 'Persists only the System, Light or Dark preference outside the encrypted financial scenario.'
    }
    evidence = component 'Opt-in launch evidence' {
      description 'Smoke modes capture native launch metadata and synthetic encrypted round-trip evidence to local artifacts.'
    }
    ui -> evidence 'Signals native window opened in smoke mode'
    ui -> workflow 'Accepts explicit edits and manual acknowledgements'
    ui -> settings 'Loads and saves theme preference'
    workflow -> importer 'Imports committed synthetic fixtures'
    workflow -> engine 'Recomputes editable state and projects remaining locked steps'
    ui -> vault 'Unlocks, saves and reopens the guided scenario'
    evidence -> importer 'Loads identical synthetic state on each OS'
    evidence -> vault 'Moves and verifies encrypted backup across OS jobs'
  }
  localfiles = system 'App-managed local experiment files' {
    description 'Encrypted working database and portable encrypted backup under the prototype data folder. The synthetic source CSV is development-only plaintext.'
  }
  build = system 'Development build tooling' {
    description 'Node and LikeC4 validate diagrams and generate local/CI build artifacts. Not shipped with the application.'
  }
  controller = system 'EXPERIMENTAL manual controller trial' {
    description 'Disposable issue #4 development-only Node harness and process supervisor. Runs fixed validation commands with deadline and controller-liveness monitoring; persists budgets, source identity, evidence hashes and events. Synthetic approval has no acceptance authority.'
  }
  runfiles = system 'Controller scratch state and receipts' {
    description 'Local single-writer checkpoints and command output, separate from financial data. Missing or changed evidence invalidates progress; changed policy requires review.'
  }
  tracker = system 'GitHub tracker sandbox' {
    description 'Issue #10 and nullabletype user Project 2 are the only authorised live-write targets. Separate response-loss phases reconcile one marked comment and Todo/In Progress before retrying. Existing operator authentication is not an unattended least-privilege boundary.'
  }
  user -> controller 'Manually invokes bounded synthetic trials'
  controller -> build 'Invokes fixed full-build entry point'
  controller -> runfiles 'Checkpoints before execution and validates receipts on resume'
  controller -> tracker 'Reconciles explicitly authorised manual sandbox writes'
  user -> prototype.ui 'Trials the synthetic guided workflow locally'
  prototype.vault -> localfiles 'Atomically writes encrypted files'
  build -> prototype 'Builds and publishes the desktop experiment'
}

views {
  view index {
    title 'EXPERIMENTAL — offline desktop and encrypted persistence'
    include *
  }
  view shell of prototype {
    title 'EXPERIMENTAL — implemented shell and persistence components'
    include *
  }
  view persistence {
    title 'EXPERIMENTAL — encrypted save and portable backup flow'
    include user, prototype.ui, prototype.importer, prototype.vault, prototype.evidence, localfiles
  }
  view reconciliation {
    title 'EXPERIMENTAL — guided reconciliation and manual settlement flow'
    include user, prototype.ui, prototype.workflow, prototype.importer, prototype.engine, prototype.vault, prototype.settings, localfiles
  }
  view controllerTrial {
    title 'EXPERIMENTAL — bounded manual controller and tracker recovery'
    include user, controller, build, runfiles, tracker
  }
}
