specification {
  element actor
  element system
  element component
}

model {
  user = actor 'Desktop user'
  prototype = system 'Experimental desktop shell' {
    description 'Disposable issues #1 and #2 experiment. Entirely local; no banking connections, calculations or payment operations.'
    ui = component 'Synthetic summary and vault window' {
      technology 'Avalonia / .NET 10'
      description 'Displays fictional constants and runs the password-unlocked synthetic persistence round trip.'
    }
    importer = component 'Bounded synthetic CSV importer' {
      technology 'CsvHelper'
      description 'Reads the committed fictional fixture under explicitly recorded, unverified Emma format assumptions.'
    }
    vault = component 'Experimental encrypted vault' {
      technology 'Microsoft.Data.Sqlite and SQLCipher'
      description 'Persists one JSON state document in an encrypted SQLite database and makes validated atomic backup and restore replacements.'
    }
    evidence = component 'Opt-in launch evidence' {
      description 'Smoke modes capture native launch metadata and synthetic encrypted round-trip evidence to local artifacts.'
    }
    ui -> evidence 'Signals native window opened in smoke mode'
    ui -> importer 'Imports committed synthetic fixture'
    ui -> vault 'Unlocks, saves, reloads, backs up and restores'
    evidence -> importer 'Loads identical synthetic state on each OS'
    evidence -> vault 'Moves and verifies encrypted backup across OS jobs'
  }
  localfiles = system 'App-managed local experiment files' {
    description 'Encrypted working database and portable encrypted backup under the prototype data folder. The synthetic source CSV is development-only plaintext.'
  }
  build = system 'Development build tooling' {
    description 'Node and LikeC4 validate diagrams and generate local/CI build artifacts. Not shipped with the application.'
  }
  snapshottrial = system 'EXPERIMENTAL authenticated snapshot trial' {
    description 'Disposable issue #13 feasibility experiment; not selected application storage. Tests a BCL PBKDF2/AES-GCM envelope, one writer, immutable generations, in-memory search and portable backups with fictional data.'
    session = component 'Vault session API' {
      technology '.NET 10'
      description 'Unlocks once, retains a derived session key, saves authenticated generations, searches loaded state, rotates passwords and creates or restores backups.'
    }
    envelope = component 'Versioned authenticated envelope' {
      technology 'PBKDF2-HMAC-SHA-256 / AES-256-GCM'
      description 'Authenticates canonical metadata and encrypted synthetic state; a format experiment requiring independent security review.'
    }
    benchmark = component 'Synthetic history and fault trial' {
      description 'Exercises 100,000 fictional transactions against agreed latency, recovery, tamper and portability gates.'
    }
    session -> envelope 'Derives keys and authenticates complete snapshots'
    benchmark -> session 'Exercises the public vault-session seam'
  }
  snapshotfiles = system 'Snapshot trial scratch files' {
    description 'Immutable authenticated generations, active-generation pointer, writer lock and portable backup. Disposable synthetic evidence only.'
  }
  user -> prototype.ui 'Views synthetic summary locally'
  prototype.vault -> localfiles 'Atomically writes encrypted files'
  build -> prototype 'Builds and publishes the desktop experiment'
  build -> snapshottrial 'Builds and runs the separate feasibility trial'
  snapshottrial.session -> snapshotfiles 'Publishes and validates immutable generations'
}

views {
  view index {
    title 'EXPERIMENTAL — offline desktop and encrypted persistence'
    include *
  }
  view shell of prototype {
    title 'EXPERIMENTAL — implemented shell and persistence components'
    include *
  }
  view persistence {
    title 'EXPERIMENTAL — encrypted save and portable backup flow'
    include user, prototype.ui, prototype.importer, prototype.vault, prototype.evidence, localfiles
  }
  view snapshot_feasibility {
    title 'EXPERIMENTAL — authenticated snapshot feasibility, not selected storage'
    include user, build, snapshottrial.*, snapshotfiles
  }
}
