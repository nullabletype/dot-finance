{
  "name": "dot-finance-development",
  "private": true,
  "engines": {
    "node": "^24.21.0 || ^26.10.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "dotnet run --project prototypes/DesktopShell/DesktopShell.csproj",
    "ui:prototype": "node scripts/ui-prototype.mjs",
    "smoke": "node scripts/smoke.mjs",
    "workflow:smoke": "node scripts/workflow-smoke.mjs",
    "persistence:smoke": "node scripts/persistence-smoke.mjs",
    "controller": "node prototypes/ControllerTrial/controller.mjs",
    "controller:trial": "node prototypes/ControllerTrial/trial.mjs",
    "architecture:format": "likec4 format docs/architecture",
    "architecture:check": "likec4 format --check docs/architecture && likec4 validate docs/architecture",
    "architecture:build": "likec4 build docs/architecture -o artifacts/architecture --base ./",
    "architecture:negative-check": "node scripts/check-invalid-model.mjs"
  },
  "devDependencies": {
    "likec4": "1.59.4"
  }
}
