{
  "name": "dot-finance-development",
  "private": true,
  "engines": {
    "node": "^24.21.0 || ^26.10.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "dotnet run --project prototypes/DesktopShell/DesktopShell.csproj",
    "ui:prototype": "node scripts/ui-prototype.mjs",
    "smoke": "node scripts/smoke.mjs",
    "workflow:smoke": "node scripts/workflow-smoke.mjs",
    "persistence:smoke": "node scripts/persistence-smoke.mjs",
    "controller": "node prototypes/ControllerTrial/controller.mjs",
    "controller:trial": "node prototypes/ControllerTrial/trial.mjs && node prototypes/ControllerTrial/tracker-trial.mjs",
    "controller:tracker": "node prototypes/ControllerTrial/tracker.mjs",
    "controller:tracker:live": "node prototypes/ControllerTrial/tracker-live-trial.mjs",
    "architecture:format": "likec4 format docs/architecture",
    "architecture:check": "likec4 format --check docs/architecture && likec4 validate docs/architecture",
    "architecture:build": "likec4 build docs/architecture -o artifacts/architecture --base ./",
    "architecture:negative-check": "node scripts/check-invalid-model.mjs",
    "production:build": "node scripts/production-build.mjs",
    "production:smoke": "node scripts/production-smoke.mjs",
    "production:vault": "node scripts/production-vault-smoke.mjs",
    "production:start": "dotnet run --project src/DotFinance.Desktop/DotFinance.Desktop.csproj",
    "production:architecture": "node scripts/production-architecture.mjs",
    "domain:mutations": "node scripts/domain-mutations.mjs"
  },
  "devDependencies": {
    "likec4": "1.59.4"
  }
}
